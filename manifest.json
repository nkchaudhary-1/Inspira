{
  "manifest_version": 3,
  "name": "Inspira — Your Day, Every New Tab",
  "short_name": "Inspira",
  "version": "2.0.0",
  "description": "A calm clock, daily inspiration and weather — with your tasks, notes, projects and calendar, one new tab away.",
  "minimum_chrome_version": "116",
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage", "identity", "alarms"],
  "optional_permissions": ["notifications"],
  "oauth2": {
    "client_id": "YOUR_OAUTH_CLIENT_ID.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/userinfo.email",
      "https://www.googleapis.com/auth/userinfo.profile",
      "https://www.googleapis.com/auth/drive.appdata"
    ]
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "optional_host_permissions": ["https://calendar.google.com/*", "https://outlook.office365.com/*", "https://outlook.live.com/*", "https://*.icloud.com/*"]
}
